# Copiez ce fichier en product/.env et renseignez votre clé Anthropic.
# Ne committez jamais product/.env (il est ignoré par git).
ANTHROPIC_API_KEY=your_key_here
# Optionnel : modèle Claude (défaut : claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5
# Optionnel (v1.3.7) : barème public de RÉFÉRENCE daté (USD/Mtok), informatif seulement — le
# barème comptabilisé reste LLM_PRICE_INPUT_EUR_PER_MTOK / LLM_PRICE_OUTPUT_EUR_PER_MTOK (3 / 15).
LLM_REFERENCE_PRICE_INPUT_USD_PER_MTOK=2.0
LLM_REFERENCE_PRICE_OUTPUT_USD_PER_MTOK=10.0
LLM_REFERENCE_PRICE_DATE=2026-09-15
# Optionnel : base de données (défaut : SQLite locale)
DATABASE_URL=sqlite:///./product_runtime.db
# Optionnel : URL de l'API vue par l'interface Streamlit (défaut : http://127.0.0.1:8000)
AI_SOS_API_URL=http://127.0.0.1:8000
