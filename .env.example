# Exemple de configuration AI-SOS (Phase 13, squelette) — cf docs/engineering/08-configuration-management.md.
# NE JAMAIS committer de vraies valeurs. Ce fichier ne contient que des placeholders sans secret.
# Rappel : les BORNES de gouvernance ne vivent PAS ici — elles sont en base, modifiables par le CEO
# seul, versionnees et auditees (cf docs/behavior/13-bounds-and-thresholds.md).

# --- Application ---
AISOS_ENV=dev                      # dev | staging | prod
AISOS_LOG_LEVEL=INFO

# --- Base de donnees (DT-05, PostgreSQL 16 + pgvector) ---
AISOS_DATABASE_URL=postgresql+psycopg://aisos_app:CHANGE_ME@localhost:5432/aisos

# --- Stockage objet S3-compatible (MinIO en dev) ---
AISOS_OBJECT_STORE_ENDPOINT=http://localhost:9000
AISOS_OBJECT_STORE_BUCKET=aisos-artifacts

# --- Fournisseur de modeles (DT-03, abstraction LLMProvider ; defaut Claude) ---
AISOS_LLM_PROVIDER=anthropic
AISOS_LLM_MODEL=claude-sonnet-5
# AISOS_LLM_API_KEY=  # fourni via gestionnaire de secrets, jamais en clair ici

# --- Authentification CEO (DT-07, OIDC/JWT ; le CEO est le seul humain) ---
AISOS_OIDC_ISSUER=
AISOS_OIDC_AUDIENCE=aisos

# --- Observabilite (DT-06) ---
AISOS_OTEL_EXPORTER_OTLP_ENDPOINT=
AISOS_LANGSMITH_ENABLED=false      # activation = decision du CEO
